<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="InkBrush" Color="#E6EDF3" />
    <SolidColorBrush x:Key="MutedInkBrush" Color="#9AA7B2" />
    <SolidColorBrush x:Key="InactiveInkBrush" Color="#6C7883" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0F1419" />
    <SolidColorBrush x:Key="PanelBrush" Color="#182028" />
    <SolidColorBrush x:Key="InputBrush" Color="#11181F" />
    <SolidColorBrush x:Key="LineBrush" Color="#2C3742" />
    <SolidColorBrush x:Key="AltRowBrush" Color="#1C252E" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#202A34" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#228763" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2A9A72" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#24303B" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#2D3B48" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1F4D3E" />
    <SolidColorBrush x:Key="SelectionInkBrush" Color="#E6EDF3" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F97066" />
</ResourceDictionary>
