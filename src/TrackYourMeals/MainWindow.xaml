<Window x:Class="TrackYourMeals.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Track Your Meals"
        Width="1240"
        Height="760"
        MinWidth="1080"
        MinHeight="680"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="PanelBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource InputBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource AltRowBrush}" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
            <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionInkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource InactiveInkBrush}" />
                    <Setter Property="Opacity" Value="0.78" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelBorderStyle}"
                Padding="18,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="{Binding ThemeToggleText}"
                            Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button Content="Recarregar"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button Content="Encerrar dia"
                            Command="{Binding CloseDayCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Track Your Meals"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0">
                        <TextBlock Text="{Binding CurrentDayLabel}"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                        <TextBlock Text="  |  "
                                   Foreground="{DynamicResource MutedInkBrush}" />
                        <TextBlock Text="{Binding DatabaseStatusLabel}"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,14,0,14">
            <Border Style="{StaticResource PanelBorderStyle}"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Calorias"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Text="{Binding TotalCalories, StringFormat={}{0:N0} kcal}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Proteína"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Text="{Binding TotalProtein, StringFormat={}{0:N1} g}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Carboidratos"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Text="{Binding TotalCarbs, StringFormat={}{0:N1} g}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Gorduras"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Text="{Binding TotalFat, StringFormat={}{0:N1} g}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorderStyle}"
                    Padding="0"
                    Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="14,12,14,10">
                        <TextBlock Text="Plano alimentar e consumo do dia"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Foods}"
                              Margin="14,0,14,14"
                              IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Alimento"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="150" />
                            <DataGridTextColumn Header="Un."
                                                Binding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}"
                                                Width="70" />
                            <DataGridTextColumn Header="Meta/dia"
                                                Binding="{Binding DailyTargetQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                Width="84" />
                            <DataGridTextColumn Header="kcal/un."
                                                Binding="{Binding CaloriesPerUnitText, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80" />
                            <DataGridTextColumn Header="Prot/un."
                                                Binding="{Binding ProteinPerUnitText, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80" />
                            <DataGridTextColumn Header="Carb/un."
                                                Binding="{Binding CarbsPerUnitText, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80" />
                            <DataGridTextColumn Header="Gord/un."
                                                Binding="{Binding FatPerUnitText, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80" />

                            <DataGridTemplateColumn Header="Consumido"
                                                    Width="90"
                                                    IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ConsumedQuantity, StringFormat={}{0:N2}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Restante"
                                                    Width="80"
                                                    IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RemainingQuantity, StringFormat={}{0:N2}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Macros hoje"
                                                    Width="175"
                                                    IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ConsumedCalories, StringFormat={}{0:N0} kcal}" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource MutedInkBrush}">
                                                <Run Text="{Binding ConsumedProtein, StringFormat={}{0:N1}, Mode=OneWay}" />
                                                <Run Text=" P  " />
                                                <Run Text="{Binding ConsumedCarbs, StringFormat={}{0:N1}, Mode=OneWay}" />
                                                <Run Text=" C  " />
                                                <Run Text="{Binding ConsumedFat, StringFormat={}{0:N1}, Mode=OneWay}" />
                                                <Run Text=" G" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Registrar"
                                                    Width="154"
                                                    IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="62"
                                                     Text="{Binding LogQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,6,0" />
                                            <Button Content="+"
                                                    Width="36"
                                                    Command="{Binding AddLogCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status"
                                                    Width="76"
                                                    IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Ações"
                                                    Width="166"
                                                    IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Salvar"
                                                    Command="{Binding SaveCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,6,0" />
                                            <Button Content="{Binding ToggleActiveText}"
                                                    Command="{Binding ToggleActiveCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          x:Name="SidePanelScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="{Binding ViewportHeight, ElementName=SidePanelScroll}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource PanelBorderStyle}"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Adicionar alimento"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Nome"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding NewFoodName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,8,0">
                                    <TextBlock Text="Unidade"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding NewFoodUnitLabel, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Meta diária"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding NewFoodDailyTargetQuantityText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,8,8">
                                    <TextBlock Text="kcal/un."
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding NewFoodCaloriesPerUnitText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,0,8">
                                    <TextBlock Text="Proteína/un."
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding NewFoodProteinPerUnitText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,8,0">
                                    <TextBlock Text="Carboidrato/un."
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding NewFoodCarbsPerUnitText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="1">
                                    <TextBlock Text="Gordura/un."
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding NewFoodFatPerUnitText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Button Content="Adicionar ao plano"
                                    Command="{Binding AddFoodCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource PanelBorderStyle}"
                            MinHeight="260">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Últimos registros"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding RecentEntries}"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      PreviewMouseWheel="RecentEntriesGrid_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hora"
                                                        Binding="{Binding LoggedAtLabel}"
                                                        Width="58" />
                                    <DataGridTextColumn Header="Alimento"
                                                        Binding="{Binding FoodName}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Qtd."
                                                        Binding="{Binding QuantityLabel}"
                                                        Width="82" />
                                    <DataGridTextColumn Header="kcal"
                                                        Binding="{Binding Calories, StringFormat={}{0:N0}}"
                                                        Width="58" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource PrimaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ErrorBrush}"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
